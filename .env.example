# =============================================================================
# NEXUS NFV – environment configuration. Copy to .env and replace EVERY value.
# Generate secrets with:  openssl rand -base64 48   (JWT/agent)  ·  openssl rand -base64 32 (credential key)
# Never commit .env.
# =============================================================================

# ---- database
DB_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# ---- platform security
NEXUS_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
# AES-256 key (base64 of exactly 32 bytes) protecting stored NETCONF credentials
NEXUS_CREDENTIAL_KEY=
# Shared secret between the control plane and firewall VNF agents (>= 16 chars)
NEXUS_AGENT_TOKEN=change-me-agent-token
NEXUS_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- bootstrap accounts (created only when the user table is empty)
NEXUS_ADMIN_USERNAME=admin
# >= 10 chars with upper, lower, digit and symbol
NEXUS_ADMIN_PASSWORD=
# optional: also create 'operator' (NETWORK_OPERATOR) and 'analyst' (SECURITY_ANALYST) with this password
NEXUS_DEMO_USERS_PASSWORD=

# ---- VNF orchestration: docker (local NFV lab) | osm | none
NEXUS_ORCHESTRATOR_MODE=docker
NEXUS_VNF_IMAGE=nexus/fw-vnf:1.0.0
NEXUS_VNF_NETCONF_ENABLED=true

# ---- OSM (only when NEXUS_ORCHESTRATOR_MODE=osm or to browse an OSM catalogue)
OSM_NBI_URL=
OSM_USERNAME=admin
OSM_PASSWORD=
OSM_PROJECT=admin
OSM_VIM_ACCOUNT=
OSM_VERIFY_TLS=true

# ---- ONOS: real (REST API) | demo (clearly labelled fixture, no controller)
NEXUS_ONOS_MODE=demo
ONOS_URL=http://onos:8181/onos/v1
ONOS_USERNAME=onos
ONOS_PASSWORD=

# ---- public deployment (deploy/docker-compose.prod.yml)
# domain pointing at the server, or <server-ip>.sslip.io when no domain is available
PUBLIC_HOST=
