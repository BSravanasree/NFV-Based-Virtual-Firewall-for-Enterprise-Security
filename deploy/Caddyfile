# Automatic HTTPS (Let's Encrypt) for PUBLIC_HOST. Registration works without an e-mail address; to receive
# expiry notices add a global block:  { email you@example.com }
{$PUBLIC_HOST} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy frontend:80
	log {
		output stdout
		format console
	}
}
