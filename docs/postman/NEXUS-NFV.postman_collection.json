              "raw": "{\n  \"name\": \"fw-postman\",\n  \"vnfType\": \"FIREWALL\",\n  \"cpuLimit\": 0.5,\n  \"memoryLimitMb\": 256,\n  \"defaultAction\": \"DROP\"\n}"
            }
